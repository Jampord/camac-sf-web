# Copy to .env and fill in. Never commit .env.

# --- Database (Neon Postgres) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"
# Direct (unpooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (plus your Vercel URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed for `npm start` or hosts other than Vercel (Vercel and `npm run dev` trust the host automatically).
# AUTH_TRUST_HOST=true

# --- Seed data (npm run db:seed) ---
# Comma-separated. Only these emails can sign in. Keep real addresses out of the repo.
SEED_ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# Admins who can read prayer requests (added as admins automatically).
SEED_PRAYER_EMAILS=""

# --- Later build steps (not used yet) ---
# Step 2: Cloudinary poster uploads
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Step 7: prayer notifications via a dedicated Gmail account + app password
# SMTP_USER=""
# SMTP_APP_PASSWORD=""
# Step 7: protects cron routes
# CRON_SECRET=""
