# Copy to .env and fill in. Never commit .env.

# --- Database (Neon Postgres) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"
# Direct (unpooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (plus your Vercel URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed for `npm start` or hosts other than Vercel (Vercel and `npm run dev` trust the host automatically).
# AUTH_TRUST_HOST=true

# --- Seed data (npm run db:seed) ---
# Comma-separated. Only these emails can sign in. Keep real addresses out of the repo.
SEED_ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# Admins who can read prayer requests (added as admins automatically).
SEED_PRAYER_EMAILS=""

# --- Cloudinary (event posters) ---
# Console -> Settings -> API Keys. The secret signs admin uploads on the server; never expose it.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Prayer notifications ---
# A dedicated Gmail account (not a personal inbox) with 2-Step Verification on, and an app password
# from https://myaccount.google.com/apppasswords. Left blank, requests still save; emails just skip.
SMTP_USER=""
SMTP_APP_PASSWORD=""

# --- Daily cleanup job ---
# Any long random value, e.g. openssl rand -base64 33. Vercel Cron sends it automatically once it's
# set in the project's env vars. Left blank, /api/cron/daily refuses everyone and nothing is cleaned.
CRON_SECRET=""

# --- Error tracking (Sentry) ---
# Project Settings -> Client Keys (DSN). Left blank, nothing is sent; errors still reach the logs.
SENTRY_DSN=""
